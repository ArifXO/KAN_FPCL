# Model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt

# Reports — figures ignored, result tables tracked
reports/figures/*.png
reports/figures/*.pdf
reports/tables/*.tex
# Final result tables — explicitly tracked
!reports/tables/*.csv
!reports/tables/*.md

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

