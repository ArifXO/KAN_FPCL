# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
.env

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Hydra outputs
outputs/
multirun/
.hydra/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data (download on demand, never commit)
/data/
!configs/data/
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle

# Run artifacts — large outputs are never committed. Per-run dirs are named
# "{cell_id}_s{seed}_{run_id}" by save_run_artifacts, not "run_*", so the old
# rule never matched. Ignore everything under each sub-folder and re-include
# the .gitkeep placeholders so the directory skeleton stays in git.
_archive_preaudit/
runs/ablation/*
runs/ablation/**/*
runs/archive/*
runs/archive/**/*
runs/checkpoints/*
runs/checkpoints/**/*
runs/smoke/*
runs/smoke/**/*
runs/figures/*
runs/tables/*
# Aggregate CSV/JSON outputs from ablate.py / probe.py / analyze_geometry.py
# (regenerable from per-run artifacts; not part of the source tree).
runs/results/*.csv
runs/results/*.json
# Keep placeholder markers so the runs/ skeleton is preserved.
!runs/**/.gitkeep
*.pt
*.pth
*.ckpt

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Archived stale results (dev-iteration artifacts)
_archive_old_results/

# Secrets
.env
*.key
*.pem
secrets.yaml
